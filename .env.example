# Copy to .env and adjust. .env is not committed.

# Where raw downloads and the built dataset are stored (tens of GB).
# Default: <repo>/data
SONIC_DATA_DIR=

# Freesound API key for "python -m sonic.dataset freesound" (https://freesound.org/apiv2/apply/)
FREESOUND_API_KEY=

# --- Web app ---
# 1 for local development; 0 in production (then SONIC_SECRET_KEY is required)
SONIC_DEBUG=1
SONIC_SECRET_KEY=
SONIC_ALLOWED_HOSTS=localhost,127.0.0.1
# Where uploaded audio is stored (default: <SONIC_DATA_DIR>/web_uploads)
SONIC_UPLOAD_DIR=
# Shared password for the demo accounts created by "python manage.py seed_users"
SONIC_DEMO_PASSWORD=
